rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Amministratore: gestisce gli inviti (stesso UID di ADMIN_UID in store.js).
    function admin() {
      return request.auth != null && request.auth.uid == 'EHdWC7e44TZIzsgIuy9STAi6SuO2';
    }

    function emailVerificata() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function emailUtente() {
      return request.auth.token.email.lower();
    }

    // Accesso consentito solo agli invitati (documento inviti/{email}) e all'amministratore.
    function invitato() {
      return admin()
        || (emailVerificata() && exists(/databases/$(database)/documents/inviti/$(emailUtente())));
    }

    // Inviti: ID documento = email in minuscolo. Ognuno può controllare solo il proprio invito.
    match /inviti/{email} {
      allow get: if admin() || (emailVerificata() && emailUtente() == email);
      allow list, delete: if admin();
      allow create: if admin()
        && email == email.lower()
        && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.keys().hasOnly(['creato'])
        && request.resource.data.creato is string;
    }

    // Richieste di invito: ID documento = email in minuscolo dell'utente che la invia.
    // Una sola richiesta per email; solo l'amministratore le elenca e le elimina.
    match /richieste/{email} {
      allow get: if admin() || (emailVerificata() && emailUtente() == email);
      allow list, delete: if admin();
      allow create: if emailVerificata()
        && emailUtente() == email
        && request.resource.data.keys().hasOnly(['nome', 'uid', 'creato'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 100
        && request.resource.data.creato is string
        && request.resource.data.creato.size() <= 40;
    }

    // Ogni utente invitato legge e scrive solo i propri giorni.
    match /users/{uid}/giorni/{data} {
      allow read, delete: if request.auth != null && request.auth.uid == uid && invitato();

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && invitato()
        && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.data == data
        && request.resource.data.keys().hasOnly([
             'data', 'entrata', 'inizio_mensa', 'fine_mensa', 'durata_pausa_min',
             'minuti_extra', 'uscita_calcolata', 'ultimo_aggiornamento'
           ])
        && request.resource.data.entrata is string
        && request.resource.data.inizio_mensa is string
        && request.resource.data.fine_mensa is string
        && request.resource.data.uscita_calcolata is string
        && request.resource.data.minuti_extra is int
        && (request.resource.data.durata_pausa_min == null || request.resource.data.durata_pausa_min is int)
        && request.resource.data.ultimo_aggiornamento is string;
    }

    // Tutto il resto è negato.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
